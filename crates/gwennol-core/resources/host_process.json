{
  "formatVersion": 1,
  "name": "host_process",
  "version": "0.1.0",
  "description": "Gwennol process step type. Native code; every step asks the operator before acting. Not freelyUsable: a plugin must hold the step_type:host_process.run grant.",
  "stepTypeDefs": [
    {
      "name": "host_process.run",
      "inputSchema": {
        "type": "object",
        "required": ["argv"],
        "additionalProperties": false,
        "properties": {
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Program and arguments. No shell is involved. The child's environment is the frontend's policy, not the plugin's: by default an allow-list, not the agent's own environment." },
          "cwd": { "type": "string", "description": "Working directory (default: workspace root)." },
          "stdin": { "type": "string" },
          "timeout_ms": { "type": "integer", "minimum": 0, "default": 120000 },
          "max_output_bytes": { "type": "integer", "minimum": 0, "default": 1048576, "description": "Cap on captured stdout and stderr, each." }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["status", "stdout", "stderr", "stdout_truncated", "stderr_truncated"],
        "properties": {
          "status": { "type": ["integer", "null"], "description": "Exit code; null if killed by a signal." },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "stdout_truncated": { "type": "boolean" },
          "stderr_truncated": { "type": "boolean" }
        }
      }
    }
  ],
  "stepTypeImpls": [
    { "stepType": "host_process.run", "kind": "native", "implRef": "gwennol.host_process.run" }
  ]
}
